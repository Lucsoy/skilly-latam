erDiagram
  reservas {
    varchar_50 id PK
    varchar_20 codigo UK
    varchar_50 organizacion_id FK
    varchar_50 profesional_id FK
    varchar_50 servicio_id FK
    datetime inicio
    datetime fin
    enum modalidad
    text mensaje
    int precio
    decimal_5_2 comision_porcentaje
    int comision
    int total
    enum estado
    enum estado_pago
    tinyint conformidad_confirmada
    datetime conformidad_fecha
    datetime aceptacion_fecha
    varchar_255 aceptacion_usuario
    varchar_20 aceptacion_version
    datetime reagendamiento_inicio
    datetime reagendamiento_fin
    datetime reagendamiento_solicitado
    varchar_50 administrador_asignado_id FK
    varchar_255 administrador_asignado_nombre
    datetime administrador_decidio_en
    datetime profesional_decidio_en
    datetime pago_confirmado_en
    datetime creada_en
  }
  contadores_reserva {
    smallint anio PK
    int ultimo
  }
  historial_reservas {
    varchar_50 id PK
    bigint secuencia UK
    varchar_50 reserva_id FK
    datetime fecha
    enum actor_tipo
    varchar_255 actor_nombre
    varchar_20 estado_anterior
    varchar_20 estado_nuevo
    text motivo
    text detalle
  }
  mensajes_chat {
    varchar_80 id PK
    varchar_50 reserva_id FK
    varchar_50 cuenta_id FK
    enum autor_rol
    varchar_255 autor_nombre
    text texto
    datetime enviado_en
  }
  evaluaciones {
    varchar_50 id PK
    varchar_50 reserva_id FK
    varchar_50 profesional_id FK
    varchar_50 organizacion_id FK
    enum autor
    tinyint calidad
    tinyint plazos
    tinyint comunicacion
    text comentario
    datetime fecha
    tinyint publicada
    enum estado_comentario
  }
  configuracion_plataforma {
    int id PK
    decimal_5_2 comision_porcentaje
    decimal_5_2 comision_profesional_porcentaje
    decimal_5_2 comision_organizacion_porcentaje
    int retencion_bloque_minutos

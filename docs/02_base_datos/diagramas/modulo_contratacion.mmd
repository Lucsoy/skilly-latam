    int reputacion_ventana_max
    int reputacion_ventana_meses
    int reputacion_dias_publicacion
    int reputacion_max_caracteres
    varchar_20 version_condiciones
    varchar_20 version_politica_datos
  }
  tramos_cancelacion {
    int id PK
    int desde_horas UK
    int retencion_porcentaje
    varchar_100 etiqueta
  }
  reservas ||--o{ evaluaciones : "reserva_id (RESTRICT)"
  reservas ||--o{ historial_reservas : "reserva_id (RESTRICT)"
  reservas ||--o{ mensajes_chat : "reserva_id (RESTRICT)"

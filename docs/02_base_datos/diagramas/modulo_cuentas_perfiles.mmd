erDiagram
  organizaciones {
    varchar_50 id PK
    varchar_255 razon_social
    varchar_20 rut UK
    varchar_12 rut_normalizado UK
    varchar_255 giro
    enum tamano
    varchar_255 nombre_contacto
    varchar_255 email_contacto
    varchar_50 telefono
    varchar_255 sitio_web
    text descripcion
    varchar_255 direccion
    tinyint consentimiento_aceptado
    datetime consentimiento_fecha
    varchar_20 consentimiento_version
    datetime creada_en
  }
  profesionales {
    varchar_50 id PK
    varchar_100 nombre
    varchar_100 apellido
    varchar_255 titulo
    varchar_100 ciudad
    text presentacion
    varchar_255 linkedin
    varchar_255 portafolio
    tinyint validado_por_skilly
    datetime fecha_ingreso
  }
  profesional_formacion {
    int id PK
    varchar_50 profesional_id FK
    varchar_255 descripcion
  }
  profesional_experiencia {
    int id PK
    varchar_50 profesional_id FK
    varchar_255 cargo
    varchar_255 organizacion
    varchar_100 periodo
  }
  profesional_habilidades {
    int id PK
    varchar_50 profesional_id FK
    varchar_100 habilidad
  }
  profesional_insignias {
    int id PK
    varchar_50 profesional_id FK
    enum insignia
  }
  perfiles_profesionales {
    varchar_50 profesional_id PK,FK
    varchar_255 email
    varchar_50 area_principal
    enum estado_validacion
    datetime validado_en
    text comentario_validacion
    tinyint consentimiento_aceptado
    datetime consentimiento_fecha
    varchar_20 consentimiento_version
  }
  documentos_respaldo {
    varchar_50 id PK
    varchar_50 profesional_id FK
    enum tipo
    varchar_255 nombre_archivo
    int tamano_bytes
    datetime subido_en
    enum estado
    varchar_255 ruta_archivo
    varchar_100 tipo_mime
  }
  cuentas {
    varchar_50 id PK
    varchar_255 email UK
    varchar_255 contrasena
    enum rol
    varchar_255 nombre
    varchar_50 organizacion_id FK
    varchar_50 profesional_id FK
  }
  sesiones_autenticacion {
    char_64 token_hash PK
    varchar_50 cuenta_id FK
    datetime creada_en
    datetime expira_en
  }
  intentos_login {
    int id PK
    varchar_255 email
    varchar_45 ip
    datetime fecha
  }
  organizaciones |o--o{ cuentas : "organizacion_id (SET NULL)"
  profesionales |o--o{ cuentas : "profesional_id (SET NULL)"
  profesionales ||--o{ documentos_respaldo : "profesional_id (CASCADE)"
  profesionales ||--o| perfiles_profesionales : "profesional_id (CASCADE)"
  profesionales ||--o{ profesional_experiencia : "profesional_id (CASCADE)"
  profesionales ||--o{ profesional_formacion : "profesional_id (CASCADE)"
  profesionales ||--o{ profesional_habilidades : "profesional_id (CASCADE)"
  profesionales ||--o{ profesional_insignias : "profesional_id (CASCADE)"
  cuentas ||--o{ sesiones_autenticacion : "cuenta_id (CASCADE)"

# Copia este archivo como .env.local (no se sube al repositorio) y ajusta los valores.

# true (por defecto) = API PHP + MySQL de XAMPP · false = modo demostración con datos de ejemplo
VITE_USE_API=true

# Solo para la compilación (npm run build). En desarrollo, el proxy de Vite redirige /api
# a XAMPP y esta variable no hace falta. Ejemplo si dist/ se sirve desde otro sitio:
# VITE_API_URL=http://localhost/skilly-api/api

# Destino del proxy de Vite en desarrollo (por defecto http://localhost/skilly-api)
# SKILLY_API_PROXY=http://localhost/skilly-api
